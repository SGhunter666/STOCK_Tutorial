; Stock Market Academy — Godot port.
; Deterministic exchange, full academy, multi-asset trading, career, fund, quant and tax surfaces.
config_version=5

[application]

config/name="Stock Market Academy"
config/description="Bilingual financial education and trading simulation with an event-driven story layer."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

I18n="*res://app/i18n.gd"
Game="*res://app/game.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
